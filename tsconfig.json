{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "@/*": [
        "./examples/02-project-basics/src/*"
      ]
    }
  },
  "include": [
    "examples/**/*.ts",
    "examples/**/*.tsx",
    "packages/**/*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "**/node_modules",
    "**/dist"
  ]
}
